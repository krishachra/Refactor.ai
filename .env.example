# Refactor.ai Environment Configuration
# Copy this file to .env and configure your keys.
# NEVER commit .env to version control — it is excluded by .gitignore.

# --- Active AI Provider Strategy ---
# Options:
#  - "auto"   : Tries Gemini first, then Nebius (NVIDIA), then Groq, then Deterministic Demo
#  - "gemini" : Enforces Google Gemini API (Free-tier friendly)
#  - "nebius" : Enforces Nebius Token Factory (NVIDIA Nemotron - Hackathon Requirement)
#  - "groq"   : Enforces Groq Developer API
#  - "demo"   : Uses offline deterministic fixtures (zero API key required)
AI_PROVIDER=auto

# --- Primary Development Provider: Google Gemini API ---
# Obtain your API key at: https://aistudio.google.com/apikey
# Free tier documentation: https://ai.google.dev/gemini-api/docs/pricing
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models/

# --- Mandatory Hackathon Provider: Nebius Token Factory ---
# Required for Nebius x NVIDIA Hackathon compliance
# Obtain key at: https://studio.nebius.ai/
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nebius/nvidia/Nemotron-3_5-Lightning

# --- Secondary Fallback Provider: Groq API ---
# Obtain key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1/
GROQ_MODEL=llama-3.1-8b-instant

# --- Application Server Configuration ---
APP_VERSION=1.1.0
PORT=8000
HOST=0.0.0.0
MAX_CODE_LENGTH=50000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
